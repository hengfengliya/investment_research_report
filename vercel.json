{
  "version": 2,
  "framework": "vite",
  "outputDirectory": "frontend/dist",
  "env": {
    "NODE_VERSION": "20"
  },
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "backend/dist/**"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://www.chenxing.xin/research?type=free",
      "permanent": true
    }
  ]
}
